PORT=3000
# Your GitHub Pages origin (no trailing slash), e.g. https://yourname.github.io
ALLOWED_ORIGIN=https://yourname.github.io
# Password staff use on admin.html
ADMIN_PASSWORD=change-me-to-something-long
# Random string used to sign admin sessions (e.g. output of: openssl rand -hex 32)
TOKEN_SECRET=change-me
# Staff channel webhook: new applications and decisions are posted here
DISCORD_WEBHOOK_URL=
# Optional: BattleMetrics server ID for live player count on the homepage
BATTLEMETRICS_ID=
# Optional: secret for /api/whitelist.txt?key=... (approved SteamID64s, one per line)
WHITELIST_FEED_KEY=
